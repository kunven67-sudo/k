<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.error.chillcharge"
    android:versionCode="5"
    android:versionName="5.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <!-- change brightness + screen sleep time (you allow it once in Settings) -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- close other apps running in the background (Android 13 and older) -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- the little "boost is on" notification that puts everything back when you unplug -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Claude mode: see when the Claude app is open (you allow "Usage access" once) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <!-- reactor blast shakes the phone -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- PC link: show Chill Charge to your PC on your Wi-Fi, stay awake while charging -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- BIG UNLOCK: only works after a one-time grant from a PC (adb shell pm grant ... WRITE_SECURE_SETTINGS) -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <queries>
        <package android:name="com.anthropic.claude" />
    </queries>

    <application
        android:usesCleartextTraffic="true"
        android:label="Chill Charge"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".WatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Waits for the charger to be unplugged so it can put brightness and sleep time back." />
        </service>
        <service
            android:name=".ClaudeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Plays music and keeps the charging boost only while the Claude app is open." />
        </service>

        <service
            android:name=".LinkService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows the charging screen and game to the owner's PC on the home Wi-Fi while the phone is locked." />
        </service>

        <receiver
            android:name=".AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
