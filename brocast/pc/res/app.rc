#include <winver.h>
1 ICON "brocast.ico"
1 24 "app.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 3,0,0,0
PRODUCTVERSION 3,0,0,0
FILEFLAGSMASK 0x3fL
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "BroCast"
      VALUE "FileDescription", "BroCast for PC: watch your phone's screen"
      VALUE "FileVersion", "3.0.0"
      VALUE "ProductName", "BroCast"
      VALUE "ProductVersion", "3.0.0"
      VALUE "OriginalFilename", "BroCast.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
