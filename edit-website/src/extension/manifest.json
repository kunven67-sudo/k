{
  "manifest_version": 3,
  "name": "Edit Website",
  "version": "1.0.0",
  "description": "Edit any website live: see and change its code, swap the background, add effects, buttons and your own stuff.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Edit Website (Alt+Shift+E)",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "unlimitedStorage", "scripting", "activeTab", "userScripts"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["core.js"], "run_at": "document_idle" }
  ],
  "commands": {
    "toggle-editor": {
      "suggested_key": { "default": "Alt+Shift+E" },
      "description": "Open or close Edit Website"
    }
  }
}
